<?xml version="1.0" encoding="utf-8"?>
<!-- Macht /feed.xml im Browser lesbar. Feedreader ignorieren diese Datei. -->
<xsl:stylesheet version="1.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:atom="http://www.w3.org/2005/Atom"
  exclude-result-prefixes="atom">
  <xsl:output method="html" encoding="utf-8" indent="yes" doctype-system="about:legacy-compat"/>

  <xsl:template match="/">
    <html lang="en">
      <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <meta name="color-scheme" content="dark"/>
        <title>Feed · <xsl:value-of select="atom:feed/atom:title"/></title>
        <style>
          @font-face { font-family: "DM Sans"; src: url("/assets/fonts/dm-sans.woff") format("woff"); font-weight: 300 700; font-display: swap; }
          @font-face { font-family: "Anonymous Pro"; src: url("/assets/fonts/anonymous-pro.woff") format("woff"); font-display: swap; }
          :root { color-scheme: dark; }
          * { box-sizing: border-box; }
          body { margin: 0; background: #17110d; color: #ead7b7; font: 350 1.0625rem/1.7 "DM Sans", "Helvetica Neue", Arial, sans-serif; }
          .huelle { max-width: 38rem; margin: 0 auto; padding: 3rem 1rem 5rem; }
          a { color: #e08a3c; text-underline-offset: 0.18em; }
          a:hover { color: #f2b25c; }
          .marke { font: 0.85rem "Anonymous Pro", "Courier New", monospace; letter-spacing: 0.25em; text-transform: uppercase; color: #a8916f; margin: 0; }
          h1 { font-weight: 500; font-size: 2rem; line-height: 1.2; color: #f6e8cf; margin: 0.4rem 0 1rem; }
          .hinweis { background: #221913; border-left: 3px solid #e08a3c; padding: 1rem 1.2rem; margin: 1.5rem 0 2.5rem; border-radius: 0 4px 4px 0; }
          .hinweis p { margin: 0 0 0.6rem; }
          .hinweis p:last-child { margin: 0; }
          code { font-family: "Anonymous Pro", "Courier New", monospace; background: #17110d; padding: 0.15em 0.4em; border-radius: 3px; overflow-wrap: anywhere; }
          h2 { font-size: 0.85rem; font-family: "Anonymous Pro", "Courier New", monospace; letter-spacing: 0.2em; text-transform: uppercase; color: #a8916f; font-weight: 400; margin: 0 0 1rem; }
          ul { list-style: none; margin: 0; padding: 0; }
          li { padding: 1.4rem 0; border-top: 1px solid rgba(234, 215, 183, 0.12); }
          li h3 { margin: 0.2rem 0 0.4rem; font-size: 1.3rem; font-weight: 500; line-height: 1.3; }
          li h3 a { color: #ead7b7; text-decoration: none; }
          li h3 a:hover { color: #f2b25c; }
          li p { margin: 0; color: #cdb999; }
          .datum { font: 0.85rem "Anonymous Pro", "Courier New", monospace; color: #a8916f; }
        </style>
      </head>
      <body>
        <div class="huelle">
          <p class="marke">RSS / Atom feed</p>
          <h1><xsl:value-of select="atom:feed/atom:title"/></h1>
          <div class="hinweis">
            <p><strong>This is a feed.</strong> Copy the address of this page into a feed reader and every new post comes to you on its own.</p>
            <p>Feed address: <code><xsl:value-of select="atom:feed/atom:link[@rel='self']/@href"/></code></p>
            <p><a href="/subscribe/">How to subscribe</a> · <a href="/">Back to the blog</a></p>
          </div>
          <h2>Latest posts</h2>
          <ul>
            <xsl:for-each select="atom:feed/atom:entry">
              <li>
                <span class="datum"><xsl:value-of select="substring(atom:published, 1, 10)"/></span>
                <h3><a href="{atom:link[@rel='alternate']/@href}"><xsl:value-of select="atom:title"/></a></h3>
                <p><xsl:value-of select="atom:summary"/></p>
              </li>
            </xsl:for-each>
          </ul>
        </div>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>
